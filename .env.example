FLEXXUS_BASE_URL=http://localhost:5000
FLEXXUS_USERNAME=ADMIN
FLEXXUS_PASSWORD=ADMIN
FLEXXUS_PAGE_SIZE=500

MAGENTO_BASE_URL=https://example.com/rest/default
# Use either MAGENTO_TOKEN or MAGENTO_USERNAME/MAGENTO_PASSWORD.
MAGENTO_TOKEN=replace-with-admin-or-integration-token
# MAGENTO_USERNAME=admin
# MAGENTO_PASSWORD=admin-password
MAGENTO_PAGE_SIZE=1000
MAGENTO_SKU_BATCH_SIZE=500

# Optional. If omitted, the CLI auto-detects .xls/.xlsx files in the project root.
# FLEXXUS_XLS_PATH=Planilla de Stock 25-09-2026 10-54-19.XLS

# Optional overrides if XLS auto-detection picks the wrong columns.
# FLEXXUS_XLS_SKU_COLUMN=CODIGO
# FLEXXUS_XLS_NAME_COLUMN=NOMBRE
# FLEXXUS_XLS_CATEGORY_COLUMN=CATEGORIA
# FLEXXUS_XLS_CONDITION_COLUMN=CONDICION
